[Unit]
Description=Bounded public BTCUSDT capture and verified Cloud Storage upload
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=30

[Service]
Type=simple
User=ai-trader-collector
Group=ai-trader-collector
EnvironmentFile=/etc/ai-trader-collector.env
ExecStart=/opt/ai-trader/run-collector.sh
Restart=on-failure
RestartSec=60
StateDirectory=ai-trader-collector
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ai-trader-collector
CapabilityBoundingSet=
RestrictSUIDSGID=yes
MemoryMax=800M
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
